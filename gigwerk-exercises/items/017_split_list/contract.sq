-- Exercise 017 — exact logical contract only; no authored target implementation.
-- Source semantics apply when n >= 0; n < 0 is outside the stated domain.

-- OCaml lowering: List a -> 'a list; Pair a b -> 'a * 'b.
type Nat = {Int | _v >= 0}

data Pair a b where
  P :: x: a -> y: b -> Pair a b

measure fst :: Pair a b -> a where
  P x y -> x

measure snd :: Pair a b -> b where
  P x y -> y

data List a where
  Nil :: List a
  Cons :: x: a -> xs: List a -> List a

termination measure len :: List a -> {Int | _v >= 0} where
  Nil -> 0
  Cons x xs -> 1 + len xs

-- Trusted logical relation only: append ys xs denotes xs followed by ys.
-- Its first argument is intentionally constant across structural recursion.
measure append :: ys: List a -> List a -> List a where
  Nil -> ys
  Cons x xs -> Cons x (append ys xs)

-- Exact output contract:
--   * append suffix prefix == input preserves every element, multiplicity, and order;
--   * first length is n when n fits, otherwise input length (saturation).
split :: xs: List a -> n: Nat -> {Pair (List a) (List a) | append (snd _v) (fst _v) == xs && (n <= len xs ==> len (fst _v) == n) && (len xs <= n ==> len (fst _v) == len xs)}
split = ??
